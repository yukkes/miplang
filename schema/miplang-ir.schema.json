{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://miplang.dev/schema/miplang-ir-v1alpha2.json",
  "title": "MIPLang Canonical IR v1alpha2",
  "type": "object",
  "required": ["schemaVersion", "name", "sets", "parameters", "variables", "constraints", "objectives"],
  "properties": {
    "schemaVersion": { "const": "miplang.ir/v1alpha2" },
    "name": { "type": "string" },
    "sets": { "type": "array", "items": { "$ref": "#/$defs/named" } },
    "parameters": { "type": "array", "items": { "type": "object", "required": ["name"], "properties": { "name": { "type": "string" }, "domain": { "$ref": "#/$defs/iterators" }, "integer": { "type": "boolean" }, "lower": { "$ref": "#/$defs/bound" }, "upper": { "$ref": "#/$defs/bound" } }, "additionalProperties": false } },
    "variables": { "type": "array", "items": { "type": "object", "required": ["name", "type"], "properties": { "name": { "type": "string" }, "domain": { "$ref": "#/$defs/iterators" }, "type": { "enum": ["continuous", "integer", "binary"] }, "lower": { "$ref": "#/$defs/bound" }, "upper": { "$ref": "#/$defs/bound" } }, "additionalProperties": false } },
    "constraints": { "type": "array", "items": { "type": "object", "required": ["name", "left", "operator", "right"], "properties": { "name": { "type": "string" }, "index": { "$ref": "#/$defs/iterators" }, "left": { "$ref": "#/$defs/expression" }, "operator": { "enum": ["<=", ">=", "="] }, "right": { "$ref": "#/$defs/expression" } }, "additionalProperties": false } },
    "objectives": { "type": "array", "items": { "type": "object", "required": ["name", "sense", "expr"], "properties": { "name": { "type": "string" }, "sense": { "enum": ["minimize", "maximize"] }, "index": { "$ref": "#/$defs/iterators" }, "expr": { "$ref": "#/$defs/expression" } }, "additionalProperties": false } }
  },
  "$defs": {
    "named": { "type": "object", "required": ["name"], "properties": { "name": { "type": "string" } }, "additionalProperties": false },
    "iterator": { "type": "object", "required": ["set"], "properties": { "name": { "type": "string" }, "set": { "type": "string" } }, "additionalProperties": false },
    "iterators": { "type": "array", "items": { "$ref": "#/$defs/iterator" } },
    "bound": { "type": "object", "required": ["expr"], "properties": { "expr": { "$ref": "#/$defs/expression" }, "strict": { "type": "boolean" } }, "additionalProperties": false },
    "expression": { "type": "object", "required": ["kind"], "properties": { "kind": { "enum": ["number", "reference", "unary", "binary", "sum"] }, "value": { "type": "number" }, "name": { "type": "string" }, "indices": { "type": "array", "items": { "type": "string" } }, "operator": { "enum": ["+", "-", "*", "/"] }, "left": { "$ref": "#/$defs/expression" }, "right": { "$ref": "#/$defs/expression" }, "operand": { "$ref": "#/$defs/expression" }, "iterators": { "$ref": "#/$defs/iterators" }, "body": { "$ref": "#/$defs/expression" } }, "additionalProperties": false }
  },
  "additionalProperties": false
}
